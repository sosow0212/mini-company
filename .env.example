# 컨테이너로 실행할 때는 docker-compose.yml의 environment가 이 값을 덮어쓴다.
# [SECRET] 표시가 붙은 항목만 K8s Secret, 나머지는 ConfigMap.
# Phase가 진행되며 필요한 변수만 추가한다. 여기 없는 변수는 아직 코드가 읽지 않는다.

# ─── app ────────────────────────────────────────────────
APP_ENV=local                     # local | staging | prod
LOG_LEVEL=INFO

# ─── mongo ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27018/?directConnection=true
MONGO_DB=mini_company

# ─── milvus ─────────────────────────────────────────────
MILVUS_HEALTH_URL=http://localhost:9091/healthz

# ─── internal auth ──────────────────────────────────────
# 워커가 내부 API(/internal/v1)를 호출할 때 쓰는 공유 키.
# local 기본값 change-me. staging/prod에서 이 값이면 백엔드 부팅이 거부된다.
WORKER_API_KEY=change-me          # [SECRET]

# ─── LLM: 키 (프로바이더 단위, 전부 SECRET) ──────────────
# 키는 백엔드 프로세스에만 존재한다. 워커는 프록시를 경유하므로 키를 갖지 않는다(ADR-007).
# 키 없는 프로파일이 카탈로그에 있으면 부팅을 거부한다.
MINIMAX_API_KEY=                  # [SECRET]
MINIMAX_BASE_URL=https://api.minimax.io/v1
ANTHROPIC_API_KEY=                # [SECRET] 기본 카탈로그는 anthropic을 쓰지 않는다
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ─── LLM: 카탈로그 (ConfigMap 대상, 비밀 아님) ───────────
# 비우면 llm/profiles.py의 DEFAULT_PROFILES를 쓴다. anthropic 기반 coder를 추가하려면:
# LLM_PROFILES_JSON='{"cheap":{"provider":"minimax","model":"MiniMax-M2.7","temperature":0.2,"maxTokens":1500},"coder":{"provider":"anthropic","model":"claude-sonnet-4-5","temperature":0.2,"maxTokens":8000}}'
LLM_PROFILES_JSON=
LLM_TIMEOUT_SECONDS=60

# ─── LLM: 단가표 (1M 토큰당 USD, 모델 단위) ──────────────
LLM_PRICING_JSON='{"MiniMax-M2.7":{"in":0.30,"out":1.20},"MiniMax-M3":{"in":0.30,"out":1.20},"claude-sonnet-4-5":{"in":3.00,"out":15.00}}'
USD_KRW_RATE=1380                 # 원장은 KRW로 기록. 환율도 설정값
LLM_DAILY_COST_LIMIT_KRW=5000     # 초과 시 프록시가 429로 거부. 0 이하면 검사 안 함

# ─── worker ─────────────────────────────────────────────
BACKEND_BASE_URL=http://localhost:8000   # 워커가 호출하는 백엔드 주소
EMPLOYEE_NAME=수집가 노아                # 더미 워커가 수행할 직원 (시드 이름과 일치해야 한다)

# ─── 임베딩 (Phase 7) ────────────────────────────────────
EMBEDDING_PROVIDER=hashing
OPENAI_API_KEY=                   # [SECRET] EMBEDDING_PROVIDER=openai일 때 필요
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# 차원을 바꾸면 기존 벡터를 전부 버려야 한다. 부팅 시 Milvus 컬렉션과 비교해
# 불일치면 앱을 띄우지 않는다 — 통과시키면 검색 품질만 조용히 망가진다.
EMBEDDING_DIM=1536

# ─── Milvus / RAG (Phase 7) ──────────────────────────────
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=knowledge_chunks
RAG_TOP_K=8
RAG_SCORE_THRESHOLD=0.35
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=80

# ─── 챗봇 (Phase 8) ──────────────────────────────────────
# 챗봇은 직원이 아니라서 프로파일을 이름으로 직접 고른다. 비용은 employee_id 없이
# 원장에 기록된다 — 챗봇 비용도 회사 손익이다.
CHAT_LLM_PROFILE=reasoner
CHAT_HISTORY_LIMIT=10
